# ==============================================================================
# SISTEM SMART HOME "RUMAH" - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi '.env' dan sesuaikan nilainya.
# JANGAN commit file .env ke version control!
# ==============================================================================

# --- SERVER & NETWORK ---
APP_ENV=development
APP_DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=ganti_dengan_random_secret_key_yang_sangat_panjang_dan_aman_minimal_32_karakter
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BASE_PUBLIC_URL=https://aujasena.my.id

# --- GOOGLE OAUTH2 (LOGIN & ACCOUNT LINKING) ---
# Dapatkan dari Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin:
#   - https://aujasena.my.id (Production)
#   - http://localhost:5173 (Development)
# Authorized redirect URI:
#   - https://aujasena.my.id/login (Production)
#   - http://localhost:5173/login (Development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- SMTP EMAIL SERVICE (OTP LUPA SANDI & QR PAIRING) ---
# Untuk Gmail: gunakan smtp.gmail.com port 587 (STARTTLS) atau 465 (SSL) dan App Password 16 karakter
# Mode Fallback Dev: Jika dikosongkan, OTP & kode verifikasi otomatis di-log rapi di terminal backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nexa Home <no-reply@aujasena.my.id>
SMTP_TLS=true
SMTP_SSL=false

# --- DATABASE ---
DATABASE_URL=sqlite+aiosqlite:///./server/data/rumah.db

# --- MQTT BROKER ---
# Untuk pengembangan lokal: 'localhost' atau '127.0.0.1' port 1883
# Broker cloud cadangan: HiveMQ / EMQX
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=rumah_server
MQTT_PASSWORD=ganti_password_mqtt_server_di_sini
MQTT_CLIENT_ID=rumah_core_server
MQTT_TOPIC_PREFIX=home

# --- MEDIAMTX (KAMERA STREAMING) ---
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889

# --- AI & LLM PROVIDER ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- TEXT-TO-SPEECH (TTS) ---
TTS_PROVIDER=edge-tts
# Opsi suara edge-tts: id-ID-ArdiNeural atau id-ID-GadisNeural
PIPER_MODEL_PATH=./server/data/models/piper/id_ID-news_tts-medium.onnx
PIPER_CONFIG_PATH=./server/data/models/piper/id_ID-news_tts-medium.onnx.json

# --- AI VISION WORKER ---
VISION_ENABLED=false
VISION_MAX_CAMERAS=2
VISION_TARGET_FPS=3
VISION_INPUT_WIDTH=640
VISION_INPUT_HEIGHT=640
YOLO_POSE_MODEL_PATH=./models/yolo11n-pose.onnx
YOLO_DET_MODEL_PATH=./models/yolo11n.onnx

# --- RETENSI DATA ---
RECORDING_RETENTION_DAYS=7
TELEMETRY_RETENTION_DAYS=90
